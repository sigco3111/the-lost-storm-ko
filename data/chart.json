  "specialties": [
    {
      "id": "hearth",
      "name": "난로",
      "path": "stone",
      "description": "불 속에 서서 견뎌내라. 생명력, 방어력, 그리고 일격마다 되받아 타오르는 난로."
    },
    {
      "id": "kiln",
      "name": "가마",
      "path": "stone",
      "description": "그대가 치는 모든 것이 계속 타오른다. 더 세게 내리꽂히는 불, 그리고 적들의 발밑에 남는 불타는 땅."
    },
    {
      "id": "rockfall",
      "name": "낙석",
      "path": "stone",
      "description": "산비탈을 무너뜨리는 무거운 일격. 더 느리지만 더 세게 치고, 멀리 날려 버리는 휘두르기."
    },
    {
      "id": "maelstrom",
      "name": "대소용돌이",
      "path": "blade",
      "description": "방 전체를 끌어들이는 회전. 물레방아가 적들을 끌어당기고, 넓어지며, 곁에 붙잡아 둔다."
    },
    {
      "id": "spring_tide",
      "name": "사리",
      "path": "blade",
      "description": "싸움을 마셔라. 일격마다 돌려받고, 약병은 마르지 않는다."
    },
    {
      "id": "tidal_bore",
      "name": "밀물 급류",
      "path": "blade",
      "description": "물결을 타고 들어가라. 구를 때마다 앞으로 물이 솟고, 물살이 멀리 빠르게 달린다."
    },
    {
      "id": "squall_line",
      "name": "소나기 선",
      "path": "storm",
      "description": "그대와 함께 걷는 폭풍. 곁에 머물고, 따라오고, 치유하는 폭풍."
    },
    {
      "id": "forked_sky",
      "name": "갈라진 하늘",
      "path": "storm",
      "description": "하나에 멈추지 않는 번개. 더 많은 연쇄, 더 많은 발사체, 처치할 때마다 다시 갈라진다."
    },
    {
      "id": "static_front",
      "name": "정전기 전선",
      "path": "storm",
      "description": "터지기 전 공기 속의 전하. 깊은 마나, 무거운 낙인, 그리고 맞을 때 응답하는 번개."
    },
    {
      "id": "hailfall",
      "name": "우박 폭풍",
      "path": "wind",
      "description": "무리 위로 쏟아지는 연발. 더 많은 볼트, 더 넓은 부채, 그리고 튀어 이어지는 사격."
    },
    {
      "id": "penumbra",
      "name": "반그림자",
      "path": "wind",
      "description": "어둠을 데리고 다녀라. 자라고, 지속되고, 처치할 때마다 다시 일어나는 암영."
    },
    {
      "id": "far_dark",
      "name": "먼 어둠",
      "path": "wind",
      "description": "깊은 은폐에서의 먼 사격. 모든 것을 꿰뚫는 볼트, 그리고 구를 때마다의 장막."
    }
  ],
